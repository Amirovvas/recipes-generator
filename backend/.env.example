# Порт сервера
PORT=3001

# Сколько прокси стоит перед сервером (0 локально, 1 на Render/Railway/за nginx)
TRUST_PROXY=0

# Адрес фронтенда (CORS)
CORS_ORIGIN=http://localhost:5173

# Supabase (Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Страница фронта, куда ведёт ссылка из письма подтверждения
AUTH_EMAIL_REDIRECT_TO=http://localhost:5173

# ИИ: Google Gemini через OpenAI-совместимый API (бесплатный тариф)
# Ключ: https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=

# Модель для текста рецепта. flash-lite отвечает за ~3 с;
# gemini-3.8-flash на бесплатном тарифе — 90+ с
AI_TEXT_MODEL=gemini-3.1-flash-lite
# Глубина размышлений: minimal | low | medium | high (low — быстрый ответ)
AI_REASONING_EFFORT=low

# Фото блюда.
# Без ключа — бесплатный анонимный Pollinations (с водяным знаком сервиса).
# С ключом — OpenAI-совместимый API картинок без водяного знака.
# Ключ Pollinations: https://enter.pollinations.ai/keys (секретный sk_...)
IMAGE_API_KEY=
IMAGE_BASE_URL=https://gen.pollinations.ai/v1
IMAGE_MODEL=black-forest-labs/flux.1-schnell
IMAGE_SIZE=1024x1024
